#include <windows.h>
#include <commctrl.h>
#include "resource.h"

1 VERSIONINFO
FILEVERSION 0,2,1,0
PRODUCTVERSION 0,2,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Paradox Modding Toolkit for Notepad++"
            VALUE "FileVersion", "0.2.1.0"
            VALUE "ProductName", "Paradox Modding Toolkit"
            VALUE "ProductVersion", "0.2.1"
            VALUE "LegalCopyright", "Copyright 2026 Joel Deffner"
            VALUE "OriginalFilename", "PxToolkit.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_PANEL DIALOGEX 0, 0, 600, 220
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Paradox Toolkit"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_TABS, WC_TABCONTROL, WS_TABSTOP, 5, 4, 590, 18
    EDITTEXT IDC_QUERY, 5, 26, 190, 15, ES_AUTOHSCROLL
    PUSHBUTTON "Find symbols", IDC_SEARCH, 200, 26, 70, 15
    PUSHBUTTON "Preview rename", IDC_RENAME, 275, 26, 78, 15
    PUSHBUTTON "Apply preview", IDC_APPLY, 358, 26, 72, 15
    PUSHBUTTON "Refresh", IDC_REFRESH, 435, 26, 55, 15
    PUSHBUTTON "Options", IDC_OPTIONS, 495, 26, 55, 15
    COMBOBOX IDC_SEVERITY, 5, 46, 120, 70, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    CONTROL "Current file only", IDC_CURRENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 135, 46, 100, 14
    LTEXT "", IDC_STATUS, 240, 46, 350, 14
    CONTROL "", IDC_RESULTS, WC_LISTVIEW, LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_TABSTOP | WS_BORDER, 5, 65, 590, 100
END

IDD_OPTIONS DIALOGEX 0, 0, 480, 442
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Paradox Toolkit options"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Game", -1, 10, 13, 95, 12
    COMBOBOX IDC_GAME, 110, 10, 360, 80, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Game data folder", -1, 10, 39, 95, 12
    EDITTEXT IDC_GAMEPATH, 110, 36, 305, 15, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_GAME_BROWSE, 420, 36, 50, 15
    LTEXT "", IDC_GAMEPATH_HELP, 110, 54, 360, 24
    LTEXT "Script docs folder", -1, 10, 85, 95, 12
    EDITTEXT IDC_LOGSPATH, 110, 82, 305, 15, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_LOGS_BROWSE, 420, 82, 50, 15
    LTEXT "", IDC_LOGSPATH_HELP, 110, 100, 360, 24
    LTEXT "Localization language", -1, 10, 131, 97, 12
    COMBOBOX IDC_LANGUAGE, 110, 128, 360, 160, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT "Custom language", IDC_CUSTOMLANGUAGE_LABEL, 10, 153, 95, 12
    EDITTEXT IDC_CUSTOMLANGUAGE, 110, 150, 360, 15, ES_AUTOHSCROLL
    LTEXT "", IDC_LANGUAGE_HELP, 110, 168, 360, 24
    LTEXT "Server override", -1, 10, 201, 95, 12
    EDITTEXT IDC_COMMAND, 110, 198, 360, 15, ES_AUTOHSCROLL
    LTEXT "Advanced: leave blank to use the bundled server and compatible downloaded updates. Otherwise, enter an executable or .cmd launcher.", -1, 110, 216, 360, 24
    CONTROL "Show completion while typing", IDC_COMPLETION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 248, 225, 14
    CONTROL "Show argument help while typing", IDC_SIGNATURE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 250, 248, 220, 14
    CONTROL "Syntax colors", IDC_SYNTAX, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 267, 225, 14
    CONTROL "Extra colors from language server", IDC_SEMANTIC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 250, 267, 220, 14
    CONTROL "Code folding", IDC_FOLDING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 286, 225, 14
    CONTROL "Check for language server updates", IDC_AUTOUPDATE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 250, 286, 220, 14
    LTEXT "Completion inserts", -1, 10, 315, 95, 12
    COMBOBOX IDC_MODE, 110, 312, 140, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "Hover detail", -1, 265, 315, 65, 12
    COMBOBOX IDC_HOVER, 335, 312, 135, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "", IDC_MODE_HELP, 110, 332, 140, 24
    LTEXT "", IDC_HOVER_HELP, 335, 332, 135, 24
    PUSHBUTTON "Check server updates", IDC_CHECK, 10, 362, 110, 18
    PUSHBUTTON "Plugin releases", IDC_RELEASES, 130, 362, 85, 18
    LTEXT "Server updates load after a server restart. Plugin updates need a Notepad++ restart.", -1, 230, 360, 240, 24
    LTEXT "", IDC_OPTIONSTATUS, 10, 390, 460, 22
    DEFPUSHBUTTON "Save and apply", IDOK, 300, 414, 100, 18
    PUSHBUTTON "Close", IDCANCEL, 410, 414, 60, 18
END
